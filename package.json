    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "express": "^4.21.0",
    "pg": "^8.13.0",
    "kafkajs": "^2.2.4",
    "@aws-sdk/client-s3": "^3.700.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
