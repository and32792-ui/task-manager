{
  "name": "task-manager",
  "version": "2.0.0",
  "description": "Task manager with big-data pipeline: PostgreSQL, Kafka, Ozone, Spark",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
