# Application
PORT=3000

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=taskmanager
PG_USER=taskmanager
PG_PASSWORD=taskmanager
PG_POOL_MAX=20

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=task-manager-api
KAFKA_TOPIC=task-events

# Apache Ozone (S3-compatible)
OZONE_S3_ENDPOINT=http://localhost:9878
OZONE_REGION=us-east-1
OZONE_ACCESS_KEY=ozone-access-key
OZONE_SECRET_KEY=ozone-secret-key
